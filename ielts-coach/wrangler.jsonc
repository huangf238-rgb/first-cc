{
  // IELTS speaking coach: one Worker serves the phone web app (public/) and the /api/* backend.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ielts-coach",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // All practice records and the user's keys live in one SQLite-backed Durable Object.
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  // Daily Opus summary: 19:30 UTC = 21:30 in Cairo (winter time).
  "triggers": { "crons": ["30 19 * * *"] },
  "observability": { "enabled": true }
}
